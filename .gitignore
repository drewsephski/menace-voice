# OS metadata
.DS_Store

# Python bytecode, virtual environments, and tool caches
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Environment files. Glob rather than exact names, so variants like
# .env.prod.server or .env.local are covered too. Only the committed
# *.example templates are exempt.
.env*
!*.env.example
!.env*.example

# Conductor personal/per-machine overrides (settings.toml IS committed)
.conductor/settings.local.toml

# logs and run directory on production
/logs/
/run/
*.log
*.pid
infrastructure/
prd/

# JavaScript dependencies and generated build output
node_modules/
.pnpm-store/
.next*/
.turbo/
.vercel/
coverage/
*.tsbuildinfo

.devcontainer/install.local.sh
.playwright-mcp
.playwright-cli/
/coturn/
*.wav
dograh_pcm_cache/

# Local agent artifacts
.omo/
.codegraph
.debug-journal.md

# Generated UI QA workspaces
/ui/tmp/

# Superpowers brainstorm mockups (local only)
.superpowers/
docs/superpowers/
.gstack/
