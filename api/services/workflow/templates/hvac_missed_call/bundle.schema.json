{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://menacevoice.local/schemas/hvac-missed-call-template-bundle-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["template_bundle", "nodes", "edges"],
  "properties": {
    "template_bundle": {
      "type": "object",
      "required": [
        "slug",
        "version",
        "schema_version",
        "checksum",
        "name",
        "description",
        "default_workflow_configuration",
        "template_context",
        "required_fields",
        "disposition_map",
        "severe_categories",
        "safety_policy",
        "escalation_policy",
        "callback_policy"
      ]
    },
    "nodes": {"type": "array", "minItems": 1},
    "edges": {"type": "array"}
  }
}
