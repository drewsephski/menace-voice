{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-icon-preview/types/**/*.ts",
    ".next-layout-qa/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-quick-setup/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-*",
    "tmp"
  ]
}
